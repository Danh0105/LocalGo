# Zalo Mini App config (see mini.zalo.me dev tools)
APP_ID=
ZMP_TOKEN=

# Base URL of the LocalGo backend REST API, including the /api/v1 prefix.
# Public HTTPS endpoint reachable from Zalo Mini App and real devices.
VITE_API_BASE_URL=https://api.localgo.skilltripx.com.vn/api/v1

# Enable only after the private credential status/issue/acknowledge backend is deployed and verified.
# Never enable this as a substitute for backend CSPRNG generation and Argon2 persistence.
VITE_GARDEN_INITIAL_PASSWORD_ENABLED=false
